# ==============================================================================
# RunDB Native .dockerignore
# ==============================================================================

# Version Control
.git/
.gitignore
.gitattributes

# Docker configurations
Dockerfile*
docker-compose*.yml
.dockerignore

# Build artifacts & caches (prevents host build pollution)
build/
build-*/
cmake-build-*/
out/
bin/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CMakeUserPresets.json
CTestTestfile.cmake
.ninja_deps
.ninja_log
compile_commands.json
compile_flags.txt

# Object files and libraries
*.o
*.obj
*.a
*.lib
*.dylib
*.dll
*.exe
*.so
# Ensure bundled jemalloc is retained for Docker build
!lib/libjemalloc.so

# Package manager local caches
.vcpkg/
vcpkg_installed/
vcpkg-manifest-install.log

# Persistence, Runtime Data & Logs
*.log
*.aof
*.rdb
appendonly.aof*
data/
*.pid
rundb.pid

# Python & Testing artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Test suites & benchmark scripts (not required in release container build)
tests/
scripts/

# Project documentation & repo metadata (prevents cache invalidation)
README.md
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
LICENSE
.github/

# Development scripts
remake.sh

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo
*~
.clangd/
.cache/

# OS-generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Environment variables & secrets
.env
.env.*
!.env.example
